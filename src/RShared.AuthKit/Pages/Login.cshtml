@page "/authkit/login"
@model RShared.AuthKit.Pages.LoginModel
@inject Microsoft.Extensions.Options.IOptions<RShared.AuthKit.AuthKitOption> AuthKit

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@AuthKit.Value.LoginPageTitle</title>
	<style>
		body { font-family: system-ui, sans-serif; background: #f5f5f5; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
		.authkit-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,.08); padding: 32px; width: 320px; }
		.authkit-card h1 { font-size: 20px; margin: 0 0 20px; }
		.authkit-error { color: #b00020; font-size: 14px; margin-bottom: 12px; }
		.authkit-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
		.authkit-form input { padding: 9px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; }
		button { padding: 9px 10px; border: 0; border-radius: 6px; font-size: 14px; cursor: pointer; }
		button[type=submit] { background: #1a73e8; color: #fff; }
		.authkit-google { background: #fff; border: 1px solid #dadce0; width: 100%; }
		.authkit-separator { color: #888; font-size: 12px; text-align: center; margin: 12px 0; }
	</style>
</head>
<body>
	<div class="authkit-card">
		<h1>@AuthKit.Value.LoginPageTitle</h1>

		@if (!string.IsNullOrEmpty(Model.Error))
		{
			<div class="authkit-error">@Model.Error</div>
		}

		@if (AuthKit.Value.Google is not null)
		{
			<form method="get" asp-page="/authkit/login" asp-page-handler="Google">
				<input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
				<button type="submit" class="authkit-google">Continue with Google</button>
			</form>
			<div class="authkit-separator">or</div>
		}

		@if (AuthKit.Value.Telegram is not null)
		{
			<form class="authkit-form" method="post" asp-page="/authkit/login" asp-page-handler="Telegram">
				<input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
				<input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" placeholder="Telegram code" value="" />
				<button type="submit">Sign in with Telegram code</button>
			</form>
			<div class="authkit-separator">or</div>
		}

		@if (AuthKit.Value.Password is not null)
		{
			<form class="authkit-form" method="post" asp-page="/authkit/login" asp-page-handler="Password">
				<input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
				<input type="text" name="login" autocomplete="username" placeholder="Login" value="" />
				<input type="password" name="password" autocomplete="current-password" placeholder="Password" />
				<button type="submit">Sign in</button>
			</form>
		}
	</div>
</body>
</html>
