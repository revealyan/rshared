@page "/authkit/forgot"
@model RShared.IdentityKit.Pages.ForgotPasswordModel

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Reset password</title>
	<style>
		body { font-family: system-ui, sans-serif; background: #f5f5f5; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
		.authkit-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,.08); padding: 32px; width: 320px; }
		.authkit-card h1 { font-size: 20px; margin: 0 0 20px; }
		.authkit-info { color: #1a73e8; font-size: 14px; margin-bottom: 12px; }
		.authkit-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
		.authkit-form input { padding: 9px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; }
		button[type=submit] { padding: 9px 10px; border: 0; border-radius: 6px; font-size: 14px; cursor: pointer; background: #1a73e8; color: #fff; }
		.authkit-links { display: flex; justify-content: center; font-size: 13px; margin-top: 16px; }
		.authkit-links a { color: #1a73e8; text-decoration: none; }
	</style>
</head>
<body>
	<div class="authkit-card">
		<h1>Reset password</h1>

		@if (Model.Requested)
		{
			<div class="authkit-info">If the email is registered, a reset code has been sent to it.</div>
			<div class="authkit-links"><a href="/authkit/reset">I have a code</a></div>
		}
		else
		{
			<form class="authkit-form" method="post" asp-page="/authkit/forgot">
				<input type="email" name="email" autocomplete="username" placeholder="Email" value="" required />
				<button type="submit">Send reset code</button>
			</form>
			<div class="authkit-links"><a href="/authkit/login">Back to sign in</a></div>
		}
	</div>
</body>
</html>
